{
  // The site is fully prerendered (`output: 'static'`), so `dist/` is deployed as
  // static assets. Do NOT add the @astrojs/cloudflare adapter: it bundles the
  // native `@resvg/resvg-js` dependency used by the OG image route and breaks the
  // build. Having this file also stops `wrangler deploy` from auto-configuring
  // the project with the adapter.
  "name": "portfolio",
  "compatibility_date": "2026-10-06",
  // Run the Astro build before deploying so `dist/` always exists, even if the
  // Workers Builds "Build command" field is empty in the dashboard. Leave that
  // field empty to avoid building twice.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
