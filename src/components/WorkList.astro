---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface WorkRow {
  slug: string;
  title: string;
  summary: string;
  stack: string[];
  kind: 'case-study' | 'project';
}

interface Props {
  lang: Lang;
  entries: WorkRow[];
}

const { lang, entries } = Astro.props;
const base = lang === 'es' ? '/trabajo' : '/en/work';
const readLabel = (kind: 'case-study' | 'project') =>
  pick(ui[kind === 'case-study' ? 'work.read' : 'work.readProject'], lang);
---

<div class="flex flex-col">
  {
    entries.map((entry) => (
      <a
        href={`${base}/${entry.slug}/`}
        class="group border-line flex items-center justify-between gap-6 border-t py-6 last:border-b"
      >
        <div>
          <h3 class="text-ink group-hover:text-accent text-[22px] leading-[1.3] font-semibold transition-colors">
            {entry.title}
          </h3>
          <p class="text-muted mt-1.5 max-w-[62ch]">{entry.summary}</p>
          <p class="mono-label text-muted mt-2.5">{entry.stack.join(' · ')}</p>
        </div>
        <span class="text-accent shrink-0 text-[15px] font-medium whitespace-nowrap transition-transform duration-150 group-hover:translate-x-0.5">
          {readLabel(entry.kind)} <span aria-hidden="true">→</span>
        </span>
      </a>
    ))
  }
</div>
