---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { experience } from '../data/experience';

interface Props {
  lang: Lang;
  showTech?: boolean;
}

const { lang, showTech = true } = Astro.props;

const esMonths = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const enMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function fmtMonth(date: string, lang: Lang): string {
  const [year, month] = date.split('-').map(Number);
  const months = lang === 'es' ? esMonths : enMonths;
  return `${months[month - 1]} ${year}`;
}
---

<div class="space-y-0">
  {
    experience.map((entry) => (
      <article class="border-line grid grid-cols-1 gap-2 border-b py-8 first:pt-0 last:border-b-0 last:pb-0 sm:grid-cols-[10.5rem_1fr] sm:items-baseline sm:gap-6">
        <div class="mono-label text-muted">
          <time datetime={entry.start} class="whitespace-nowrap">
            {fmtMonth(entry.start, lang)}
          </time>
          {'\u00A0– '}
          {entry.end ? (
            <time datetime={entry.end} class="whitespace-nowrap">
              {fmtMonth(entry.end, lang)}
            </time>
          ) : (
            <span class="whitespace-nowrap">{lang === 'es' ? 'actualidad' : 'present'}</span>
          )}
        </div>
        <div>
          <h3 class="text-ink text-[1.25rem] leading-[1.3] font-semibold tracking-[-0.01em]">{entry.title}</h3>
          <p class="text-muted mt-1 text-[15px]">{pick(entry.orgLine, lang)}</p>
          <ul class="accent-list mt-4 space-y-2">
            {pick(entry.bullets, lang).map((bullet) => (
              <li class="text-ink">{bullet}</li>
            ))}
          </ul>
          {showTech && (
            <p class="mono-label text-muted mt-4 flex flex-wrap items-center">
              {entry.tech.map((tech, i) => (
                <>
                  {i > 0 && (
                    <span class="text-subtle" aria-hidden="true">
                      &nbsp;·&nbsp;
                    </span>
                  )}
                  {tech}
                </>
              ))}
            </p>
          )}
        </div>
      </article>
    ))
  }
</div>
