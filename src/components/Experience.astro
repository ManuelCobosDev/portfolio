---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { experience } from '../data/experience';

interface Props {
  lang: Lang;
  showTech?: boolean;
}

const { lang, showTech = true } = Astro.props;

const esMonths = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const enMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function fmtMonth(date: string, lang: Lang): string {
  const [year, month] = date.split('-').map(Number);
  const months = lang === 'es' ? esMonths : enMonths;
  return `${months[month - 1]} ${year}`;
}
---

<div class="space-y-0">
  {
    experience.map((entry) => (
      <article class="grid grid-cols-1 gap-2 border-b border-line py-8 first:pt-0 last:border-b-0 last:pb-0 sm:grid-cols-[9rem_1fr] sm:gap-6">
        <div class="font-mono text-[13px] tracking-[0.01em] text-muted">
          <time datetime={entry.start}>{fmtMonth(entry.start, lang)}</time>
          {' – '}
          {entry.end ? <time datetime={entry.end}>{fmtMonth(entry.end, lang)}</time> : <span>{lang === 'es' ? 'actualidad' : 'present'}</span>}
        </div>
        <div>
          <h3 class="text-[1.25rem] font-semibold leading-[1.3] tracking-[-0.01em] text-ink">{entry.title}</h3>
          <p class="mt-1 text-[15px] text-muted">{pick(entry.orgLine, lang)}</p>
          <ul class="accent-list mt-4 space-y-2">
            {pick(entry.bullets, lang).map((bullet) => <li class="text-ink">{bullet}</li>)}
          </ul>
          {
            showTech && (
              <p class="mt-4 flex flex-wrap items-center font-mono text-[13px] tracking-[0.01em] text-muted">
                {
                  entry.tech.map((tech, i) => (
                    <>
                      {i > 0 && <span class="text-subtle" aria-hidden="true">&nbsp;·&nbsp;</span>}
                      {tech}
                    </>
                  ))
                }
              </p>
            )
          }
        </div>
      </article>
    ))
  }
</div>
