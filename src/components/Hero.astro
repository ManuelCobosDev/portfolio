---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import Ficha from './Ficha.astro';
import ExternalLink from './ExternalLink.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cvHref = lang === 'es' ? '/cv/' : '/en/cv/';

const lead = {
  es: 'Java y Spring Boot en el servidor, Angular en el cliente. Desarrollo microservicios y aplicaciones web para el sector bancario, con mensajería sobre Kafka y RabbitMQ. Vivo en Cáceres y trabajo en remoto.',
  en: 'Java and Spring Boot on the server, Angular on the client. I build microservices and web applications for the banking sector, with messaging on Kafka and RabbitMQ. Based in Cáceres, working remotely.',
} as const;
---

<section class="section-pad">
  <div class="shell grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="flex flex-col justify-center lg:col-span-7">
      <p class="text-muted flex items-center gap-2.5 text-[15px]">
        <span class="bg-accent inline-block h-2 w-2 rounded-full" aria-hidden="true"></span>
        {pick(ui.status, lang)}
      </p>

      <h1 class="text-ink mt-6 text-[clamp(2.5rem,1.6rem+4vw,4.5rem)] leading-[1.02] font-extrabold tracking-[-0.02em]">
        {profile.name}<span class="sr-only">, </span>
        <span
          class="text-muted mt-3 block text-[clamp(1.25rem,1rem+1vw,1.75rem)] leading-[1.25] font-normal tracking-[-0.01em]"
        >
          {pick(profile.role, lang)}
        </span>
      </h1>

      <p class="text-ink mt-6 max-w-[56ch] text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] leading-[1.55]">
        {lead[lang]}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="rise-in bg-accent text-on-accent hover:bg-accent-hover inline-flex min-h-11 items-center rounded-md px-5 py-3 text-[15px] font-semibold transition-colors"
          style="--i:0"
        >
          {pick(ui['cta.contact'], lang)}
        </a>
        <a
          href={cvHref}
          class="rise-in border-accent text-accent hover:bg-accent-soft inline-flex min-h-11 items-center rounded-md border px-5 py-3 text-[15px] font-semibold transition-colors"
          style="--i:1"
        >
          {pick(ui['cta.cv'], lang)}
        </a>
      </div>

      <p class="mt-6 flex items-center gap-2 text-[15px]">
        <ExternalLink
          href={profile.linkedin}
          lang={lang}
          rel="me noopener noreferrer"
          class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em] hover:decoration-2"
        >
          LinkedIn
        </ExternalLink>
        <span class="text-subtle" aria-hidden="true">·</span>
        <ExternalLink
          href={profile.github}
          lang={lang}
          rel="me noopener noreferrer"
          class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em] hover:decoration-2"
        >
          GitHub
        </ExternalLink>
      </p>
    </div>

    <div class="lg:col-span-5">
      <Ficha lang={lang} />
    </div>
  </div>
</section>
