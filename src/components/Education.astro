---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { degrees, certifications } from '../data/education';
import { profile } from '../data/profile';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const educationHeading = lang === 'es' ? 'Formación' : 'Education';
const certHeading = lang === 'es' ? 'Certificaciones e idiomas' : 'Certifications and languages';
---

<div class="space-y-12">
  <div>
    <h3 class="text-ink text-[1.25rem] leading-[1.3] font-bold tracking-[-0.01em]">{educationHeading}</h3>
    <div class="border-line mt-4 border-t">
      {
        degrees.map((degree) => (
          <div class="border-line grid grid-cols-1 gap-1 border-b py-4 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
            <p class="mono-label tnum text-muted whitespace-nowrap sm:order-2">{degree.period}</p>
            <div class="sm:order-1">
              <p class="text-ink text-base font-medium">{pick(degree.title, lang)}</p>
              <p class="text-muted text-[15px]">{degree.org}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div>
    <h3 class="text-ink text-[1.25rem] leading-[1.3] font-bold tracking-[-0.01em]">{certHeading}</h3>
    <div class="border-line mt-4 border-t">
      {
        certifications.map((cert) => (
          <div class="border-line grid grid-cols-1 gap-1 border-b py-4 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
            <p class="mono-label text-muted whitespace-nowrap sm:order-2">{pick(cert.issuer, lang)}</p>
            <p class="text-ink text-base font-medium sm:order-1">{pick(cert.title, lang)}</p>
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-4 text-sm">
      {lang === 'es' ? 'Las certificaciones se pueden verificar en ' : 'Certifications can be verified on '}
      <a
        href={profile.certificationsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:text-accent-hover"
        ><span class="underline decoration-1 underline-offset-[0.2em] hover:decoration-2">LinkedIn</span><span
          class="external-icon -mr-[0.2em]"
          aria-hidden="true"><Icon name="lucide:arrow-up-right" class="h-[0.9em] w-[0.9em]" /></span
        ><span class="sr-only">{pick(ui.external, lang)}</span></a
      >.
    </p>
  </div>
</div>
