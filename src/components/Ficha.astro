---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import { fullYearsSince } from '../lib/years';
import { Picture } from 'astro:assets';
import portrait from '../assets/manuel-cobos-solis.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const years = fullYearsSince(profile.experienceStart);

const rows = [
  { label: lang === 'es' ? 'Rol' : 'Role', value: pick(profile.fichaRole, lang) },
  { label: lang === 'es' ? 'Empresa' : 'Company', value: pick(profile.employerLine, lang) },
  { label: lang === 'es' ? 'Ubicación' : 'Location', value: pick(profile.location, lang) },
  { label: lang === 'es' ? 'Modalidad' : 'Work mode', value: pick(profile.workMode, lang) },
  {
    label: lang === 'es' ? 'Experiencia' : 'Experience',
    value: lang === 'es' ? `Desde marzo de 2024 · más de ${years} años` : `Since March 2024 · over ${years} years`,
  },
  { label: lang === 'es' ? 'Stack principal' : 'Main stack', value: pick(profile.mainStack, lang) },
  { label: lang === 'es' ? 'Idiomas' : 'Languages', value: pick(profile.languages, lang) },
  { label: lang === 'es' ? 'Estado' : 'Status', value: pick(profile.statusOpen, lang), status: true },
];

const portraitAlt = {
  es: 'Retrato de Manuel Cobos Solís, desarrollador Full Stack',
  en: 'Portrait of Manuel Cobos Solís, Full Stack Developer',
} as const;
---

<section aria-labelledby="ficha-title" class="overflow-hidden rounded-md border border-line bg-surface">
  <h2 id="ficha-title" class="sr-only">{pick(ui['ficha.title'], lang)}</h2>
  <div class="aspect-[5/4] w-full bg-surface-2">
    <Picture
      src={portrait}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      width={640}
      height={512}
      alt={portraitAlt[lang]}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[50%_18%]"
    />
  </div>
  <dl>
    {
      rows.map((row, i) => (
        <div
          class="rise-in grid grid-cols-1 gap-1 border-t border-line px-5 py-3.5 first:border-t-0 sm:grid-cols-[10rem_1fr] sm:gap-4"
          style={`--i:${i}`}
        >
          <dt class="mono-label text-muted">{row.label}</dt>
          <dd class="tnum flex items-center text-base text-ink">
            {row.status && <span class="mr-2 inline-block h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>}
            {row.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
