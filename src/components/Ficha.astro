---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import { fullYearsSince } from '../lib/years';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const years = fullYearsSince(profile.experienceStart);
const portraitSrc = '/images/manuel-cobos-solis-profile-picture.png';

const rows = [
  { label: lang === 'es' ? 'Rol' : 'Role', value: pick(profile.fichaRole, lang) },
  { label: lang === 'es' ? 'Empresa' : 'Company', value: pick(profile.employerLine, lang) },
  { label: lang === 'es' ? 'Ubicación' : 'Location', value: pick(profile.location, lang) },
  { label: lang === 'es' ? 'Modalidad' : 'Work mode', value: pick(profile.workMode, lang) },
  {
    label: lang === 'es' ? 'Experiencia' : 'Experience',
    value: lang === 'es' ? `Desde marzo de 2024 · más de ${years} años` : `Since March 2024 · over ${years} years`,
  },
  { label: lang === 'es' ? 'Stack principal' : 'Main stack', value: pick(profile.mainStack, lang) },
  { label: lang === 'es' ? 'Idiomas' : 'Languages', value: pick(profile.languages, lang) },
];

const portraitAlt = {
  es: 'Retrato de Manuel Cobos Solís, desarrollador Full Stack',
  en: 'Portrait of Manuel Cobos Solís, Full Stack Developer',
} as const;
---

<section aria-labelledby="ficha-title" class="border-line bg-surface overflow-hidden rounded-md border">
  <h2 id="ficha-title" class="sr-only">{pick(ui['ficha.title'], lang)}</h2>
  <div class="bg-surface-2 aspect-[3/4] w-full">
    <img
      src={portraitSrc}
      width={896}
      height={1195}
      alt={portraitAlt[lang]}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[50%_15%]"
    />
  </div>
  <dl>
    {
      rows.map((row, i) => (
        <div
          class="rise-in border-line grid grid-cols-1 gap-1 border-t px-5 py-3 first:border-t-0 sm:grid-cols-[7.5rem_1fr] sm:items-baseline sm:gap-4"
          style={`--i:${i}`}
        >
          <dt class="text-muted font-sans text-[13px] font-medium">{row.label}</dt>
          <dd class="tnum text-ink text-base">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
