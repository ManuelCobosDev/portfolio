---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import { CV_PDF_PATH, CV_PDF_NAME } from '../lib/site';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  alternateHref: string;
}

const { lang, alternateHref } = Astro.props;
const homeHref = lang === 'es' ? '/' : '/en/';
const cvHref = lang === 'es' ? '/cv/' : '/en/cv/';
const pdfHref = CV_PDF_PATH;
const year = new Date().getFullYear();
const updated = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en', { dateStyle: 'long' }).format(
  new Date(profile.lastUpdated),
);
const otherLangName = lang === 'es' ? 'English' : 'Español';
const otherLangCode = lang === 'es' ? 'en' : 'es';
---

<footer class="border-line border-t">
  <div class="shell text-muted flex flex-col gap-4 py-8 text-sm">
    <Logo variant="horizontal" tagline />
    <p>
      © {year} Manuel Cobos Solís. {pick(ui['footer.rights'], lang)}
      {pick(ui['footer.privacy'], lang)}
    </p>
    <nav
      aria-label={lang === 'es' ? 'Enlaces del pie' : 'Footer links'}
      class="flex flex-wrap items-center gap-x-6 gap-y-2"
    >
      <a
        href={homeHref}
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
        >{pick(ui['breadcrumb.home'], lang)}</a
      >
      <a
        href={cvHref}
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
        >{pick(ui['nav.cv'], lang)}</a
      >
      <a
        href={pdfHref}
        download={CV_PDF_NAME}
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
        >{pick(ui['nav.cvPdf'], lang)}</a
      >
      <a
        href={profile.github}
        target="_blank"
        rel="me noopener noreferrer"
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
        >GitHub</a
      >
      <a
        href={profile.linkedin}
        target="_blank"
        rel="me noopener noreferrer"
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
        >LinkedIn</a
      >
      <a
        href={alternateHref}
        hreflang={otherLangCode}
        lang={otherLangCode}
        class="text-muted hover:text-ink inline-flex min-h-11 min-w-11 items-center underline underline-offset-4"
      >
        {otherLangName}
      </a>
    </nav>
    <p>
      {pick(ui['footer.updated'], lang)}
      {updated} · {pick(ui['footer.built'], lang)}
    </p>
  </div>
</footer>
