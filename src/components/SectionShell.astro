---
interface Props {
  number: string;
  id: string;
  title: string;
  description?: string;
}

const { number, id, title, description } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <div class="shell section-pad border-line border-t">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <p class="mono-label text-accent font-medium">{number}</p>
          <h2
            id={`${id}-title`}
            class="text-ink mt-3 text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] leading-[1.1] font-semibold tracking-[-0.02em]"
          >
            {title}
          </h2>
          {description && <p class="text-muted mt-4 max-w-[34ch] text-[0.9375rem] leading-relaxed">{description}</p>}
        </div>
      </div>
      <div class="reveal lg:col-span-8">
        <slot />
      </div>
    </div>
  </div>
</section>
