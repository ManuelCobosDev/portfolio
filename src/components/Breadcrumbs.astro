---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const homeHref = lang === 'es' ? '/' : '/en/';
---

<nav aria-label={pick(ui['breadcrumb.label'], lang)}>
  <ol class="mono-label text-muted flex flex-wrap items-center gap-2">
    <li>
      <a
        href={homeHref}
        class="text-accent hover:text-accent-hover inline-flex min-h-11 min-w-11 items-center underline decoration-1 underline-offset-[0.2em]"
      >
        {pick(ui['breadcrumb.home'], lang)}
      </a>
    </li>
    <li aria-hidden="true" class="text-subtle">›</li>
    <li aria-current="page" class="text-muted">{title}</li>
  </ol>
</nav>
