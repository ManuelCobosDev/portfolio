---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  href: string;
}

const { lang, href } = Astro.props;
const other = lang === 'es' ? 'en' : 'es';
---

<a
  href={href}
  hreflang={other}
  lang={other}
  aria-label={pick(ui['lang.switchLabel'], lang)}
  class="mono-label border-subtle text-ink hover:bg-surface-2 inline-flex h-11 w-11 items-center justify-center rounded-md border transition-colors"
>
  {pick(ui['lang.switchText'], lang)}
</a>
