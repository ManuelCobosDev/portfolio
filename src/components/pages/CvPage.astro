---
import type { Lang } from '../../i18n/utils';
import { pick } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import { profile } from '../../data/profile';
import { degrees, certifications } from '../../data/education';
import { stackGroups } from '../../data/stack';
import { fullYearsSince } from '../../lib/years';
import { CV_PDF_PATH, CV_PDF_NAME } from '../../lib/site';
import Experience from '../Experience.astro';
import Logo from '../Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const years = fullYearsSince(profile.experienceStart);
const pdfHref = CV_PDF_PATH;

const profileText = {
  es: `Desarrollador Full Stack con enfoque backend y más de ${years} años de experiencia en el sector bancario. Java 17 y 21, Spring Boot, microservicios y mensajería con Kafka y RabbitMQ en el servidor; Angular y TypeScript en el cliente.`,
  en: `Backend-oriented Full Stack Developer with over ${years} years of experience in the banking sector. Java 17 and 21, Spring Boot, microservices and messaging with Kafka and RabbitMQ on the server; Angular and TypeScript on the client.`,
} as const;

const workModeLine = lang === 'es' ? '100 % remoto' : 'fully remote';
const locationLine = lang === 'es' ? 'Cáceres, Extremadura, España' : 'Cáceres, Extremadura, Spain';

const headings = {
  profile: lang === 'es' ? 'Perfil' : 'Profile',
  experience: lang === 'es' ? 'Experiencia' : 'Experience',
  stack: lang === 'es' ? 'Stack técnico' : 'Tech stack',
  education: lang === 'es' ? 'Formación' : 'Education',
  certifications: lang === 'es' ? 'Certificaciones e idiomas' : 'Certifications and languages',
};

const h2Class = 'mt-10 border-t border-line pt-4 text-[1.5rem] font-extrabold leading-[1.2] tracking-[-0.02em] text-ink';
---

<div class="shell section-pad cv-doc">
  <div class="no-print mb-8 flex flex-col gap-3 md:flex-row md:items-center md:justify-end">
    <a
      href={pdfHref}
      download={CV_PDF_NAME}
      class="bg-accent text-on-accent hover:bg-accent-hover inline-flex min-h-11 w-full items-center justify-center rounded-md px-5 py-3 text-[15px] font-semibold transition-colors md:w-auto"
    >
      {pick(ui['cv.download'], lang)}
    </a>
    <button
      type="button"
      data-print-pdf
      data-pdf-href={pdfHref}
      class="border-accent text-accent hover:bg-accent-soft inline-flex min-h-11 w-full items-center justify-center rounded-md border px-5 py-3 text-[15px] font-semibold transition-colors md:w-auto"
    >
      {pick(ui['cv.print'], lang)}
    </button>
  </div>

  <div class="max-w-[72ch]">
    <Logo variant="mark" decorative class="mb-5 h-[30px] w-auto" />
    <h1 class="text-ink text-[clamp(2.5rem,1.6rem+4vw,4.5rem)] leading-[1.02] font-extrabold tracking-[-0.02em]">
      {profile.name}
    </h1>
    <p class="text-muted mt-3 text-[clamp(1.25rem,1rem+1vw,1.75rem)] leading-[1.25]">{pick(profile.role, lang)}</p>
    <p class="text-muted mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <span>{locationLine}</span>
      <span aria-hidden="true" class="text-subtle">·</span>
      <span>{workModeLine}</span>
      <span aria-hidden="true" class="text-subtle">·</span>
      <a
        href={`mailto:${profile.email}`}
        class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em]">{profile.email}</a
      >
      <span aria-hidden="true" class="text-subtle">·</span>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em]"
        >linkedin.com/in/manuelcobos</a
      >
      <span aria-hidden="true" class="text-subtle">·</span>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em]"
        >github.com/ManuelCobosDev</a
      >
      <span aria-hidden="true" class="text-subtle">·</span>
      <a
        href="https://manuelcobos.dev/"
        class="text-accent hover:text-accent-hover underline decoration-1 underline-offset-[0.2em]">manuelcobos.dev</a
      >
    </p>
  </div>

  <div class="max-w-[72ch]">
    <h2 class={h2Class}>{headings.profile}</h2>
    <p class="text-ink mt-4">{profileText[lang]}</p>

    <h2 class={h2Class}>{headings.experience}</h2>
    <div class="mt-2">
      <Experience lang={lang} showTech={false} />
    </div>

    <h2 class={h2Class}>{headings.stack}</h2>
    <div class="mt-2">
      <dl>
        {
          stackGroups.map((group) => (
            <div class="border-line grid grid-cols-1 gap-1 border-t py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="text-muted font-sans text-[13px] font-medium">{pick(group.label, lang)}</dt>
              <dd>
                <ul class="middot-list text-ink text-[15px] leading-relaxed">
                  {pick(group.items, lang).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <h2 class={h2Class}>{headings.education}</h2>
    <div class="mt-2">
      {
        degrees.map((degree) => (
          <div class="print-avoid-break border-line grid grid-cols-1 gap-1 border-b py-3 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
            <p class="mono-label tnum text-muted whitespace-nowrap sm:order-2">{degree.period}</p>
            <div class="sm:order-1">
              <p class="text-ink text-base font-medium">{pick(degree.title, lang)}</p>
              <p class="text-muted text-[15px]">{degree.org}</p>
            </div>
          </div>
        ))
      }
    </div>

    <h2 class={h2Class}>{headings.certifications}</h2>
    <div class="mt-2">
      {
        certifications.map((cert) => (
          <div class="print-avoid-break border-line grid grid-cols-1 gap-1 border-b py-3 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
            <p class="mono-label text-muted whitespace-nowrap sm:order-2">{pick(cert.issuer, lang)}</p>
            <p class="text-ink text-base font-medium sm:order-1">{pick(cert.title, lang)}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print-pdf]')) {
    button.addEventListener('click', () => {
      const href = button.dataset.pdfHref ?? '';
      const iframe = document.createElement('iframe');
      iframe.setAttribute('aria-hidden', 'true');
      iframe.style.position = 'fixed';
      iframe.style.right = '0';
      iframe.style.bottom = '0';
      iframe.style.width = '0';
      iframe.style.height = '0';
      iframe.style.border = '0';
      iframe.src = href;

      let settled = false;
      const remove = () => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        iframe.remove();
      };
      const openInTab = () => {
        if (settled) return;
        remove();
        window.open(href, '_blank', 'noopener');
      };
      const timer = window.setTimeout(openInTab, 3000);

      iframe.addEventListener('load', () => {
        if (settled) return;
        try {
          iframe.contentWindow?.focus();
          iframe.contentWindow?.print();
          window.setTimeout(remove, 1000);
        } catch {
          openInTab();
        }
      });

      document.body.appendChild(iframe);
    });
  }
</script>
