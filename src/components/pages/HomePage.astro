---
import type { Lang } from '../../i18n/utils';
import { pick } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import Hero from '../Hero.astro';
import SectionShell from '../SectionShell.astro';
import About from '../About.astro';
import Experience from '../Experience.astro';
import StackCore from '../StackCore.astro';
import StackGroups from '../StackGroups.astro';
import Education from '../Education.astro';
import Contact from '../Contact.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const ids = {
  about: lang === 'es' ? 'sobre-mi' : 'about',
  experience: lang === 'es' ? 'experiencia' : 'experience',
  stack: 'stack',
  education: lang === 'es' ? 'formacion' : 'education',
  contact: lang === 'es' ? 'contacto' : 'contact',
};

let counter = 0;
const num = () => String(++counter).padStart(2, '0');
---

<Hero lang={lang} />

<SectionShell number={num()} id={ids.about} title={pick(ui['section.about'], lang)}>
  <About lang={lang} />
</SectionShell>

<SectionShell number={num()} id={ids.experience} title={pick(ui['section.experience'], lang)}>
  <Experience lang={lang} />
</SectionShell>

<SectionShell number={num()} id={ids.stack} title={pick(ui['section.stack'], lang)}>
  <div class="space-y-10">
    <StackCore />
    <StackGroups lang={lang} />
  </div>
</SectionShell>

<SectionShell number={num()} id={ids.education} title={pick(ui['section.education'], lang)}>
  <Education lang={lang} />
</SectionShell>

<SectionShell number={num()} id={ids.contact} title={pick(ui['section.contact'], lang)}>
  <Contact lang={lang} />
</SectionShell>
