---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Lang } from '../../i18n/utils';
import { pick } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import Breadcrumbs from '../Breadcrumbs.astro';
import WorkDiagram from '../WorkDiagram.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'work'>;
  sectionHref: string;
  sectionLabel: string;
  alternateHref: string;
  alternateLabel: string;
}

const { lang, entry, sectionHref, sectionLabel, alternateHref, alternateLabel } = Astro.props;
const { Content } = await render(entry);
const publishedLabel = pick(ui['work.published'], lang);
const published = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en', { dateStyle: 'long' }).format(
  entry.data.publishedAt,
);
---

<div class="shell section-pad">
  <Breadcrumbs lang={lang} title={entry.data.title} />

  <article class="mt-8">
    <h1 class="text-ink mt-6 text-[clamp(2rem,1.4rem+2.5vw,3.25rem)] leading-[1.1] font-extrabold tracking-[-0.02em]">
      {entry.data.title}
    </h1>

    <p class="mono-label tnum text-muted mt-4">
      {publishedLabel}: {published} · {entry.data.stack.join(' · ')}
    </p>

    <p class="text-ink mt-6 max-w-[56ch] text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] leading-[1.55]">
      {entry.data.summary}
    </p>

    {entry.data.diagram === 'orchestrator' && <WorkDiagram lang={lang} />}

    <div class="prose-work text-ink mt-8">
      <Content />
    </div>

    {
      entry.data.kind === 'project' && entry.data.links && (
        <div class="mt-10 flex flex-wrap gap-3">
          {entry.data.links.repo && (
            <a
              href={entry.data.links.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-on-accent hover:bg-accent-hover inline-flex min-h-11 items-center gap-2 rounded-md px-5 py-3 text-[15px] font-semibold transition-colors"
            >
              {pick(ui['work.repo'], lang)}
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
            </a>
          )}
          {entry.data.links.demo && (
            <a
              href={entry.data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="border-accent text-accent hover:bg-accent-soft inline-flex min-h-11 items-center gap-2 rounded-md border px-5 py-3 text-[15px] font-semibold transition-colors"
            >
              {pick(ui['work.demo'], lang)}
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
            </a>
          )}
        </div>
      )
    }

    <nav class="border-line mt-12 flex flex-col gap-3 border-t pt-6 sm:flex-row sm:items-center sm:justify-between">
      <a
        href={sectionHref}
        class="text-accent hover:text-accent-hover inline-flex min-h-11 items-center gap-2 text-[15px] underline decoration-1 underline-offset-[0.2em] hover:decoration-2"
      >
        <Icon name="lucide:arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
        {sectionLabel}
      </a>
      <a
        href={alternateHref}
        hreflang={lang === 'es' ? 'en' : 'es'}
        lang={lang === 'es' ? 'en' : 'es'}
        class="text-accent hover:text-accent-hover inline-flex min-h-11 items-center gap-2 text-[15px] underline decoration-1 underline-offset-[0.2em] hover:decoration-2"
      >
        {alternateLabel}
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </nav>
  </article>
</div>
