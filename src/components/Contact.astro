---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import CopyEmail from './CopyEmail.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const paragraph = {
  es: 'Si tienes una oportunidad o quieres hablar de un proyecto, escríbeme por correo o por LinkedIn.',
  en: 'If you have an opportunity or want to talk about a project, email me or reach out on LinkedIn.',
} as const;

const addressLine = {
  es: 'Cáceres, Extremadura, España · Remoto',
  en: 'Cáceres, Extremadura, Spain · Remote',
} as const;
---

<div class="flex flex-col items-start gap-6">
  <p class="text-ink max-w-[56ch]">{paragraph[lang]}</p>

  <a
    href={`mailto:${profile.email}`}
    class="text-accent hover:text-accent-hover text-[clamp(1.5rem,1rem+2.5vw,2.5rem)] leading-[1.15] font-medium tracking-[-0.02em] [overflow-wrap:anywhere] underline decoration-1 underline-offset-[0.2em] hover:decoration-2"
  >
    {profile.email}
  </a>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${profile.email}`}
      class="bg-accent text-on-accent hover:bg-accent-hover inline-flex min-h-11 items-center rounded-md px-5 py-3 text-[15px] font-semibold transition-colors"
    >
      {pick(ui['email.write'], lang)}
    </a>
    <a
      href={profile.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="border-accent text-accent hover:bg-accent-soft inline-flex min-h-11 items-center rounded-md border px-5 py-3 text-[15px] font-semibold transition-colors"
    >
      LinkedIn
    </a>
    <a
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
      class="border-accent text-accent hover:bg-accent-soft inline-flex min-h-11 items-center rounded-md border px-5 py-3 text-[15px] font-semibold transition-colors"
    >
      GitHub
    </a>
    <CopyEmail lang={lang} />
  </div>

  <address class="text-muted text-[15px] not-italic">{addressLine[lang]}</address>
</div>
