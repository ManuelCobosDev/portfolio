---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { profile } from '../data/profile';
import CopyEmail from './CopyEmail.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const paragraph = {
  es: 'Si tienes una oportunidad o quieres hablar de un proyecto, escríbeme por correo o por LinkedIn.',
  en: 'If you have an opportunity or want to talk about a project, email me or reach out on LinkedIn.',
} as const;

const addressLine = {
  es: 'Cáceres, Extremadura, España · Remoto',
  en: 'Cáceres, Extremadura, Spain · Remote',
} as const;
---

<div class="flex flex-col items-start gap-6">
  <p class="max-w-[56ch] text-ink">{paragraph[lang]}</p>

  <a
    href={`mailto:${profile.email}`}
    class="text-[clamp(1.5rem,1rem+2.5vw,2.5rem)] font-medium leading-[1.15] tracking-[-0.02em] text-accent underline decoration-1 underline-offset-[0.2em] [overflow-wrap:anywhere] hover:text-accent-hover hover:decoration-2"
  >
    {profile.email}
  </a>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 py-3 text-[15px] font-medium text-on-accent transition-colors hover:bg-accent-hover"
    >
      {pick(ui['email.write'], lang)}
    </a>
    <a
      href={profile.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center rounded-md border border-accent px-5 py-3 text-[15px] font-medium text-accent transition-colors hover:bg-accent-soft"
    >
      LinkedIn
    </a>
    <a
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center rounded-md border border-accent px-5 py-3 text-[15px] font-medium text-accent transition-colors hover:bg-accent-soft"
    >
      GitHub
    </a>
    <CopyEmail lang={lang} />
  </div>

  <address class="text-[15px] not-italic text-muted">{addressLine[lang]}</address>
</div>
