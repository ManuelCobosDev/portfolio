---
import type { Lang } from '../i18n/utils';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  lang: Lang;
  rel?: string;
  class?: string;
}

const { href, lang, rel = 'noopener noreferrer', class: className } = Astro.props;
---

<a href={href} target="_blank" rel={rel} class={className}>
  <slot /><span class="external-icon" aria-hidden="true"
    ><Icon name="lucide:arrow-up-right" class="h-[0.9em] w-[0.9em]" /></span
  ><span class="sr-only">{pick(ui.external, lang)}</span>
</a>
