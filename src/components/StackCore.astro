---
import { coreTech } from '../data/stack';
import TechIcon from './TechIcon.astro';
---

<div data-stack-strip class="grid grid-cols-2 overflow-hidden rounded-md border-t border-l border-line sm:grid-cols-5">
  {
    coreTech.map((tech) => (
      <div class="group flex flex-col items-center gap-2.5 border-r border-b border-line bg-surface px-4 py-5 text-center">
        <TechIcon name={tech.icon} class="h-7 w-7 text-ink transition-colors duration-150 group-hover:text-accent" />
        <span class="text-sm text-ink">{tech.label}</span>
      </div>
    ))
  }
</div>
