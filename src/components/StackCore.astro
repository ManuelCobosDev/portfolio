---
import { coreTech } from '../data/stack';
import TechIcon from './TechIcon.astro';
---

<div data-stack-strip class="border-line grid grid-cols-2 overflow-hidden rounded-md border-t border-l sm:grid-cols-5">
  {
    coreTech.map((tech) => (
      <div class="group border-line bg-surface flex flex-col items-center gap-2.5 border-r border-b px-4 py-5 text-center">
        <TechIcon name={tech.icon} class="text-ink group-hover:text-accent h-7 w-7 transition-colors duration-150" />
        <span class="text-ink text-sm">{tech.label}</span>
      </div>
    ))
  }
</div>
