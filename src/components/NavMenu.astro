---
import type { Lang } from '../i18n/utils';
import type { NavEntry } from '../lib/nav';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  entries: NavEntry[];
  homeHref: string;
  cvHref: string;
}

const { lang, entries, homeHref, cvHref } = Astro.props;
---

<nav aria-label={pick(ui['nav.label'], lang)} class="hidden items-center gap-6 lg:flex">
  {
    entries.map((entry) => (
      <a
        href={`${homeHref}#${entry.id}`}
        data-nav-link
        class="nav-link text-muted inline-flex min-h-11 min-w-11 items-center justify-center text-[14px] font-medium transition-colors"
      >
        {entry.label}
      </a>
    ))
  }
  <a
    href={cvHref}
    class="nav-link text-muted inline-flex min-h-11 min-w-11 items-center justify-center text-[14px] font-medium transition-colors"
  >
    {pick(ui['nav.cv'], lang)}
  </a>
</nav>
