---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pick } from '../i18n/utils';
import { ui } from '../i18n/ui';

const canonical = 'https://manuelcobos.dev/404.html';
---

<BaseLayout
  lang="es"
  title="Página no encontrada | Manuel Cobos Solís"
  canonical={canonical}
  alternates={{ es: canonical, en: canonical, xDefault: canonical }}
  noindex
  ogType="website"
  ogTitle="Página no encontrada | Manuel Cobos Solís"
  ogDescription="Página no encontrada"
  ogImage="https://manuelcobos.dev/og/home-es.png"
  ogImageAlt="Manuel Cobos Solís"
>
  <div class="container section-pad">
    <h1 class="text-[clamp(2.5rem,1.6rem+4vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-ink">
      {pick(ui['notfound.title'], 'es')}
    </h1>
    <p class="mt-5 max-w-[56ch] text-lg text-muted">{pick(ui['notfound.text'], 'es')}</p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-accent px-5 py-3 text-[15px] font-medium text-on-accent transition-colors hover:bg-accent-hover"
    >
      {pick(ui['notfound.back'], 'es')}
    </a>

    <h2 lang="en" class="mt-20 text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink">
      {pick(ui['notfound.title'], 'en')}
    </h2>
    <p lang="en" class="mt-5 max-w-[56ch] text-lg text-muted">{pick(ui['notfound.text'], 'en')}</p>
    <a
      href="/en/"
      lang="en"
      class="mt-8 inline-flex min-h-11 items-center rounded-md border border-accent px-5 py-3 text-[15px] font-medium text-accent transition-colors hover:bg-accent-soft"
    >
      {pick(ui['notfound.back'], 'en')}
    </a>
  </div>
</BaseLayout>
