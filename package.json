{
  "name": "manuelcobos-dev",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check": "astro check",
    "build": "npm run prepare:assets && astro check && astro build",
    "preview": "astro preview",
    "qa": "node scripts/qa.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run qa && npm run test:e2e",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/ibm-plex-sans": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@iconify-json/lucide": "^1.2.16",
    "@iconify-json/simple-icons": "^1.2.16",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.3.0",
    "astro-icon": "^1.1.5",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.1",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "satori": "^0.12.1",
    "typescript": "^5.7.2"
  }
}
