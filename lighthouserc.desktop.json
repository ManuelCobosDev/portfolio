{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "ready in",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/en/",
        "http://localhost:4321/cv/",
        "http://localhost:4321/en/cv/",
        "http://localhost:4321/trabajo/microservicio-orquestador/",
        "http://localhost:4321/en/work/orchestrator-microservice/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 50 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
